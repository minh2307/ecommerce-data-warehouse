# =============================================================================
# Web Analytics ETL - Environment Variables
# =============================================================================

# Google Drive file ID for raw CSV data
GDRIVE_FILE_ID=1N744AnNIz7GNkfBNqMAk5zru7svIWn12

# Data layer paths (relative to project root)
RAW_DATA_PATH=data/raw
BRONZE_DATA_PATH=data/bronze
SILVER_DATA_PATH=data/silver
GOLD_DATA_PATH=data/gold

# Metadata & Logs
METADATA_PATH=metadata
LOG_PATH=logs

# Spark Configuration
SPARK_APP_NAME=WebAnalyticsETL
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=4
SPARK_SHUFFLE_PARTITIONS=200
SPARK_MAX_PARTITION_BYTES=134217728

# Log Level
LOG_LEVEL=INFO
